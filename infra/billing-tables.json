{
  "applied": false,
  "region": "eu-north-1",
  "note": "Specification only. Do not create these tables until a later reviewed phase. Existing tables are not modified. ProviderSubscriptionIndex is the webhook lookup and is not deployed.",
  "tables": [
    {
      "TableName": "OrganizationSubscriptions",
      "AttributeDefinitions": [
        {
          "AttributeName": "organization_id",
          "AttributeType": "S"
        },
        {
          "AttributeName": "provider_subscription_id",
          "AttributeType": "S"
        }
      ],
      "GlobalSecondaryIndexes": [
        {
          "IndexName": "ProviderSubscriptionIndex",
          "KeySchema": [
            {
              "AttributeName": "provider_subscription_id",
              "KeyType": "HASH"
            }
          ],
          "Projection": {
            "ProjectionType": "ALL"
          }
        }
      ],
      "KeySchema": [
        {
          "AttributeName": "organization_id",
          "KeyType": "HASH"
        }
      ],
      "BillingMode": "PAY_PER_REQUEST",
      "PointInTimeRecoverySpecification": {
        "PointInTimeRecoveryEnabled": true
      },
      "DeletionProtectionEnabled": true
    },
    {
      "TableName": "BillingEvents",
      "AttributeDefinitions": [
        {
          "AttributeName": "provider_event_id",
          "AttributeType": "S"
        },
        {
          "AttributeName": "organization_id",
          "AttributeType": "S"
        },
        {
          "AttributeName": "received_at",
          "AttributeType": "S"
        }
      ],
      "GlobalSecondaryIndexes": [
        {
          "IndexName": "OrganizationBillingEventsIndex",
          "KeySchema": [
            {
              "AttributeName": "organization_id",
              "KeyType": "HASH"
            },
            {
              "AttributeName": "received_at",
              "KeyType": "RANGE"
            }
          ],
          "Projection": {
            "ProjectionType": "ALL"
          }
        }
      ],
      "KeySchema": [
        {
          "AttributeName": "provider_event_id",
          "KeyType": "HASH"
        }
      ],
      "BillingMode": "PAY_PER_REQUEST",
      "PointInTimeRecoverySpecification": {
        "PointInTimeRecoveryEnabled": true
      },
      "DeletionProtectionEnabled": true
    }
  ],
  "runtime_iam": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "BillingItemsWithoutDelete",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem"
        ],
        "Resource": [
          "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationSubscriptions",
          "arn:aws:dynamodb:eu-north-1:481838970142:table/BillingEvents"
        ]
      },
      {
        "Sid": "BillingEventsByOrganization",
        "Effect": "Allow",
        "Action": "dynamodb:Query",
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/BillingEvents/index/OrganizationBillingEventsIndex"
      }
    ]
  }
}

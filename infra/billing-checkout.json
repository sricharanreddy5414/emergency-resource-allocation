{
  "applied": false,
  "region": "eu-north-1",
  "note": "Specification only. Do not create the Lambda, routes, or secret. The existing API and the nine deployed functions stay unchanged. Authenticated billing routes use authorizer y0hzhr. The webhook route has no Cognito authorizer.",
  "route": {
    "restApiId": "4c6dni17l3",
    "stage": "dev",
    "method": "POST",
    "path": "/billing/checkout",
    "authorization": "COGNITO_USER_POOLS",
    "authorizerId": "y0hzhr",
    "function": "erap-billing",
    "alias": "live"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/billing",
      "authorization": "COGNITO_USER_POOLS",
      "authorizerId": "y0hzhr",
      "function": "erap-billing",
      "alias": "live"
    },
    {
      "method": "GET",
      "path": "/billing/plans",
      "authorization": "COGNITO_USER_POOLS",
      "authorizerId": "y0hzhr",
      "function": "erap-billing",
      "alias": "live"
    },
    {
      "method": "POST",
      "path": "/billing/checkout",
      "authorization": "COGNITO_USER_POOLS",
      "authorizerId": "y0hzhr",
      "function": "erap-billing",
      "alias": "live"
    },
    {
      "method": "POST",
      "path": "/billing/cancel",
      "authorization": "COGNITO_USER_POOLS",
      "authorizerId": "y0hzhr",
      "function": "erap-billing",
      "alias": "live"
    },
    {
      "method": "GET",
      "path": "/billing/events",
      "authorization": "COGNITO_USER_POOLS",
      "authorizerId": "y0hzhr",
      "function": "erap-billing",
      "alias": "live"
    }
  ],
  "secret": {
    "name": "erap/billing/razorpay/test",
    "store": "AWS Secrets Manager",
    "keys": ["key_id", "key_secret", "webhook_secret"],
    "values": "not stored in git"
  },
  "runtime_iam": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ReadMembershipForCheckout",
        "Effect": "Allow",
        "Action": ["dynamodb:GetItem", "dynamodb:Query"],
        "Resource": [
          "arn:aws:dynamodb:eu-north-1:481838970142:table/Organizations",
          "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationMembers",
          "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationMembers/index/UserSubIndex"
        ]
      },
      {
        "Sid": "CheckoutReferenceWithoutDelete",
        "Effect": "Allow",
        "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationSubscriptions"
      },
      {
        "Sid": "TestRazorpaySecret",
        "Effect": "Allow",
        "Action": "secretsmanager:GetSecretValue",
        "Resource": "arn:aws:secretsmanager:eu-north-1:481838970142:secret:erap/billing/razorpay/test*"
      },
      {
        "Sid": "BillingEventsByOrganization",
        "Effect": "Allow",
        "Action": "dynamodb:Query",
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/BillingEvents/index/OrganizationBillingEventsIndex"
      }
    ]
  },
  "webhook": {
    "restApiId": "4c6dni17l3",
    "stage": "dev",
    "method": "POST",
    "path": "/billing/webhook",
    "authorization": "NONE",
    "function": "erap-billing-webhook",
    "alias": "live",
    "authentication": "Razorpay HMAC-SHA256 of the raw body"
  },
  "entitlement_iam": {
    "note": "Specification only. Attach GetItem to every operational Lambda that calls authorize with access write, and only after OrganizationSubscriptions exists. A missing row stays grandfathered. Do not grant PutItem here.",
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ReadSubscriptionForEnforcement",
        "Effect": "Allow",
        "Action": "dynamodb:GetItem",
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationSubscriptions"
      }
    ]
  },
  "trial_iam": {
    "note": "Specification only. Attach only to erap-create-organization. The trial write is a conditional put. It does not scan and it does not update an existing row.",
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "CreateTrialSubscription",
        "Effect": "Allow",
        "Action": ["dynamodb:GetItem", "dynamodb:PutItem"],
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationSubscriptions"
      }
    ]
  },
  "webhook_iam": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "WebhookSubscriptionItem",
        "Effect": "Allow",
        "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationSubscriptions"
      },
      {
        "Sid": "WebhookSubscriptionLookup",
        "Effect": "Allow",
        "Action": "dynamodb:Query",
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationSubscriptions/index/ProviderSubscriptionIndex"
      },
      {
        "Sid": "WebhookEventsWithoutDelete",
        "Effect": "Allow",
        "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/BillingEvents"
      },
      {
        "Sid": "TestWebhookSecret",
        "Effect": "Allow",
        "Action": "secretsmanager:GetSecretValue",
        "Resource": "arn:aws:secretsmanager:eu-north-1:481838970142:secret:erap/billing/razorpay/test*"
      }
    ]
  }
}

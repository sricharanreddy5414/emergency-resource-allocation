  },
  "runtime_iam": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ReadMembershipForCheckout",
        "Effect": "Allow",
        "Action": ["dynamodb:GetItem", "dynamodb:Query"],
        "Resource": [
          "arn:aws:dynamodb:eu-north-1:481838970142:table/Organizations",
          "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationMembers",
          "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationMembers/index/UserSubIndex"
        ]
      },
      {
        "Sid": "CheckoutReferenceWithoutDelete",
        "Effect": "Allow",
        "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
        "Resource": "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationSubscriptions"
      },
      {
        "Sid": "TestRazorpaySecret",
        "Effect": "Allow",
        "Action": "secretsmanager:GetSecretValue",
        "Resource": "arn:aws:secretsmanager:eu-north-1:481838970142:secret:erap/billing/razorpay/test*"

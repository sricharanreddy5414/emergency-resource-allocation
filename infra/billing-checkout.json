{
  "applied": false,
  "region": "eu-north-1",
  "note": "Phase C specification only. Do not create the Lambda, route, or secret until a later reviewed phase. The existing API and the nine deployed functions stay unchanged.",
  "route": {
    "restApiId": "4c6dni17l3",
    "stage": "dev",
    "method": "POST",
    "path": "/billing/checkout",
    "authorization": "COGNITO_USER_POOLS",
    "authorizerId": "y0hzhr",
    "function": "erap-billing",
    "alias": "live"
  },
  "secret": {
    "name": "erap/billing/razorpay/test",
    "store": "AWS Secrets Manager",
    "keys": ["key_id", "key_secret", "webhook_secret"],

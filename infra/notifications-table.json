{
  "applied": true,
  "region": "eu-north-1",
  "note": "Notifications created in eu-north-1 for Phase 8B. Do not redesign PK/SK or add GSIs. runtime_iam reflects least-privilege (DeleteItem and Scan omitted).",
  "tables": [

{
  "applied": true,
  "region": "eu-north-1",
  "note": "ResourceExchanges created in eu-north-1 for Phase 5G. Do not redesign PK/SK or add GSIs. runtime_iam reflects least-privilege for erap-exchange (DeleteItem omitted; application never deletes rows).",
  "tables": [
    {
      "TableName": "ResourceExchanges",
      "AttributeDefinitions": [
        {
          "AttributeName": "pk",
          "AttributeType": "S"
        },
        {
          "AttributeName": "sk",
          "AttributeType": "S"
        },
        {
          "AttributeName": "network_list_key",
          "AttributeType": "S"
        },
        {
          "AttributeName": "created_at",
          "AttributeType": "S"
        },
        {
          "AttributeName": "requester_organization_id",
          "AttributeType": "S"
        },
        {
          "AttributeName": "provider_organization_id",
          "AttributeType": "S"
        },
        {
          "AttributeName": "expiry_due_key",
          "AttributeType": "S"
        },
        {
          "AttributeName": "expiry_due_at",
          "AttributeType": "S"
        }
      ],
      "KeySchema": [
        {
          "AttributeName": "pk",
          "KeyType": "HASH"
        },
        {
          "AttributeName": "sk",
          "KeyType": "RANGE"
        }
      ],
      "GlobalSecondaryIndexes": [
        {
          "IndexName": "NetworkOpenRequestIndex",
          "KeySchema": [
            {
              "AttributeName": "network_list_key",
              "KeyType": "HASH"
            },
            {
              "AttributeName": "created_at",
              "KeyType": "RANGE"
            }
          ],
          "Projection": {
            "ProjectionType": "ALL"
          }
        },
        {
          "IndexName": "RequesterOrgIndex",
          "KeySchema": [
            {
              "AttributeName": "requester_organization_id",
              "KeyType": "HASH"
            },
            {
              "AttributeName": "created_at",
              "KeyType": "RANGE"
            }
          ],
          "Projection": {
            "ProjectionType": "ALL"
          }
        },
        {
          "IndexName": "ProviderOrgOfferIndex",
          "KeySchema": [
            {
              "AttributeName": "provider_organization_id",
              "KeyType": "HASH"
            },
            {
              "AttributeName": "created_at",
              "KeyType": "RANGE"
            }
          ],
          "Projection": {
            "ProjectionType": "ALL"
          }
        },
        {
          "IndexName": "ExpiryDueIndex",
          "KeySchema": [
            {
              "AttributeName": "expiry_due_key",
              "KeyType": "HASH"
            },
            {
              "AttributeName": "expiry_due_at",
              "KeyType": "RANGE"
            }
          ],
          "Projection": {
            "ProjectionType": "ALL"
          }
        }
      ],
      "BillingMode": "PAY_PER_REQUEST",
      "PointInTimeRecoverySpecification": {
        "PointInTimeRecoveryEnabled": true
      },
      "DeletionProtectionEnabled": true
    }
  ],
  "runtime_iam": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ResourceExchangesItems",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:Query",
          "dynamodb:TransactWriteItems"
        ],
        "Resource": [
          "arn:aws:dynamodb:eu-north-1:481838970142:table/ResourceExchanges"
        ]
      },
      {
        "Sid": "ResourceExchangesIndexes",
        "Effect": "Allow",
        "Action": "dynamodb:Query",
        "Resource": [
          "arn:aws:dynamodb:eu-north-1:481838970142:table/ResourceExchanges/index/NetworkOpenRequestIndex",
          "arn:aws:dynamodb:eu-north-1:481838970142:table/ResourceExchanges/index/RequesterOrgIndex",
          "arn:aws:dynamodb:eu-north-1:481838970142:table/ResourceExchanges/index/ProviderOrgOfferIndex",
          "arn:aws:dynamodb:eu-north-1:481838970142:table/ResourceExchanges/index/ExpiryDueIndex"
        ]
      }
    ]
  }
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishExistingFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateAlias",
        "lambda:GetAlias",
        "lambda:GetFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:UpdateAlias",
        "lambda:UpdateFunctionCode"
      ],
      "Resource": [
        "arn:aws:lambda:eu-north-1:481838970142:function:get-resources",
        "arn:aws:lambda:eu-north-1:481838970142:function:get-resources:*",
        "arn:aws:lambda:eu-north-1:481838970142:function:create-request",
        "arn:aws:lambda:eu-north-1:481838970142:function:create-request:*",
        "arn:aws:lambda:eu-north-1:481838970142:function:emergency-resource-allocation",
        "arn:aws:lambda:eu-north-1:481838970142:function:emergency-resource-allocation:*",
        "arn:aws:lambda:eu-north-1:481838970142:function:emergency-resource-auto-release",
        "arn:aws:lambda:eu-north-1:481838970142:function:emergency-resource-auto-release:*",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-catalog",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-catalog:*",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-public-resources",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-public-resources:*",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-locations",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-locations:*",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-create-organization",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-create-organization:*",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-get-organization",
        "arn:aws:lambda:eu-north-1:481838970142:function:erap-get-organization:*"
      ]
    },
    {
      "Sid": "ReadApiConfiguration",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": [
        "arn:aws:apigateway:eu-north-1::/restapis/4c6dni17l3",
        "arn:aws:apigateway:eu-north-1::/restapis/4c6dni17l3/*"
      ]
    },
    {
      "Sid": "ReadTableProtection",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-north-1:481838970142:table/Organizations",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/OrganizationMembers",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/Locations",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/Resources",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/EmergencyRequests",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/Allocations",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/ResourceStatusHistory",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/ResourceTypes",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/RequestTypes",
        "arn:aws:dynamodb:eu-north-1:481838970142:table/AuditEvents"
      ]
    },
    {
      "Sid": "ReadAlarms",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "ReadAmplifyJobs",
      "Effect": "Allow",
      "Action": [
        "amplify:GetApp",
        "amplify:GetBranch",
        "amplify:ListJobs"
      ],
      "Resource": [
        "arn:aws:amplify:us-east-1:481838970142:apps/d3enpe7opotop5",
        "arn:aws:amplify:us-east-1:481838970142:apps/d3enpe7opotop5/*"
      ]
    }
  ]
}
